# Copy to .env (or export these in your shell) and point them at your own
# authorized, locally downloaded copy of OASIS-3. Never commit a real .env --
# it is gitignored.

# Root of your own OASIS-3 working directory, laid out as:
#   $AD_STAGE_NET_ROOT/data/raw/oasis3/OASIS3_data_files/scans/...   (source CSVs + imaging, from NITRC-IR)
#   $AD_STAGE_NET_ROOT/data/processed/...                            (script outputs)
#   $AD_STAGE_NET_ROOT/models/...
#   $AD_STAGE_NET_ROOT/results/...
#   $AD_STAGE_NET_ROOT/predictions/...
# All scripts under src/ read and write relative to this root, never
# relative to a path inside this repository.
AD_STAGE_NET_ROOT=/path/to/your/oasis3-working-directory

# Directory containing an installed FastSurfer checkout (used only by
# src/data/segment_rois_fastsurfer.py). FastSurfer is a third-party tool
# with its own license and is not vendored in this repository -- install it
# separately per https://github.com/Deep-MI/FastSurfer.
FASTSURFER_HOME=/path/to/FastSurfer
